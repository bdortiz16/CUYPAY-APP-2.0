# ─────────────────────────────────────────────────────────────
# CuyPay backend — variables de entorno (copiar a .env)
# Las variables vacías se ignoran. En modo mock no hace falta ningún secreto.
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
PORT=8080
# 127.0.0.1 por defecto; 0.0.0.0 para exponer en la red (simulador iOS en otra máquina, contenedor, etc.)
HOST=127.0.0.1
LOG_LEVEL=info

# mock = adaptadores simulados (por defecto) | live = Coinsenda/Sumsub/Sartblock reales
PROVIDERS_MODE=mock

# ── Auth / sesiones ──
# Obligatorio en producción (mín. 32 caracteres). En dev se usa uno inseguro por defecto.
JWT_SECRET=
JWT_ISSUER=cuypay
JWT_AUDIENCE=cuypay-ios
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Desfase máximo del X-CuyPay-Timestamp en peticiones firmadas
SIGNATURE_MAX_SKEW_SECONDS=120
CHALLENGE_TTL_SECONDS=120
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Rate limit de /v1/auth/* (por IP)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
# CORS desactivado si está vacío. Ej: https://admin.cuypay.com,https://ops.cuypay.com
CORS_ORIGINS=
# Habilita /v1/admin/* (revisión de beneficiarios en pending_review). Mín. 24 caracteres.
ADMIN_API_KEY=

# ── Coinsenda (@coinsenda/sdk 1.9.0) ──
# coinsenda.com (producción) | bitsenda.com (staging)
COINSENDA_DOMAIN=bitsenda.com
# Email de la cuenta Coinsenda de CuyPay (identificador del token firmado)
COINSENDA_EMAIL=
# Clave privada RSA (PEM pkcs8 o pkcs1). En una sola línea usar \n. Su pública va en
# Perfil → API Public Key de la cuenta Coinsenda. En producción: desde KMS/secret manager.
COINSENDA_PRIVATE_KEY_PEM=
# Id del medio Bre-B provisionado (catálogo depositAccount) para crear llaves de usuario
COINSENDA_BREB_DEPOSIT_ACCOUNT_ID=
# Cuenta COP (ómnibus) de CuyPay en Coinsenda: recibe depósitos y origina retiros
COINSENDA_COP_ACCOUNT_ID=
# withdrawProvider Bre-B (de withdrawProvider.find where enabled/visible)
COINSENDA_BREB_WITHDRAW_PROVIDER_ID=
# Frecuencia del sondeo de depósitos y retiros pendientes
DEPOSIT_POLL_INTERVAL_MS=15000

# ── Sumsub (KYC) ──
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
# Secreto del webhook (X-Payload-Digest). En mock: dev-sumsub-webhook-secret
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_TOKEN_TTL_SECONDS=1200

# ── Sartblock (AML) ──
SARTBLOCK_BASE_URL=
SARTBLOCK_API_KEY=

# ── Liquidez BRL (socio por definir) ──
# Por defecto igual a PROVIDERS_MODE. "mock" permite usar Coinsenda/Sumsub reales con FX simulado.
BRL_PROVIDER_MODE=

# ── FX y tarifas ──
# Spread de CuyPay sobre la tasa media (puntos básicos)
FX_SPREAD_BPS=150
# Comisión de conversión: max(CONVERSION_FEE_MIN_MINOR, monto * bps / 10000)
CONVERSION_FEE_BPS=100
CONVERSION_FEE_MIN_MINOR=0
QUOTE_TTL_SECONDS=30
# Comisión fija por envío Bre-B (unidades menores COP)
TRANSFER_FEE_MINOR=0

# ── Límites ──
# JSON opcional que reemplaza los límites por defecto (ver src/config.ts DEFAULT_LIMITS). Ej:
# {"basic":[{"operation":"transfer_out","period":"daily","limitMinor":50000000}],"full":[...]}
LIMITS_CONFIG_JSON=

# ── Demo ──
# Crea la usuaria demo al arrancar (por defecto true en development + mock)
SEED_DEMO=
# Rutas /v1/dev/* (solo mock y no-producción; por defecto true en ese caso)
ENABLE_DEV_ROUTES=
