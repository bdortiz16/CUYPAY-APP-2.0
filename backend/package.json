{
  "name": "cuypay-backend",
  "version": "0.1.0",
  "description": "CuyPay API (Fastify + TypeScript)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:once": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@coinsenda/sdk": "1.9.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.3",
    "node-rsa": "^2.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/node-rsa": "^1.1.4",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
