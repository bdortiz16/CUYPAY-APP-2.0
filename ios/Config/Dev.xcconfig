// Configuración Dev: backend local + modo mock por defecto (ver esquema CuyPay-Dev).
// Nota: en .xcconfig "//" inicia un comentario, por eso la URL usa el truco "/$()/".
CUYPAY_API_BASE_URL = http:/$()/localhost:8080/v1
// "mock" = MockAPIClient con datos demo · "live" = APIClient contra CUYPAY_API_BASE_URL.
// La variable de entorno CUYPAY_API_MODE del esquema tiene prioridad sobre este valor.
CUYPAY_API_MODE = mock
CUYPAY_ENVIRONMENT_NAME = Dev
