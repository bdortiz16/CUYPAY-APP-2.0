# Automatización de publicación de CuyPay iOS.
#
# Variables de entorno necesarias (en tu Mac o como secretos de GitHub):
#   ASC_KEY_CONTENT             Contenido del archivo .p8 (texto)            ← SECRETO
#   MATCH_PASSWORD              Contraseña con la que match cifra los certificados ← SECRETO
#   MATCH_GIT_TOKEN             Token de GitHub con acceso a cuypay-certificates ← SECRETO (el workflow arma la autorización)
# Opcionales (tienen valor por defecto; no son secretos):
#   CUYPAY_TEAM_ID (YRFDF3T7CQ) · ASC_KEY_ID (Y4G39PY7CG) · ASC_ISSUER_ID · MATCH_GIT_URL
#   CUYPAY_MATCH_READONLY=true para prohibir que match cree certificados (por defecto los crea solo si faltan).
#
# Uso:
#   bundle exec fastlane tests       # compila y corre pruebas
#   bundle exec fastlane beta        # sube un build Prod a TestFlight
#   bundle exec fastlane release     # sube el build a App Store Connect para revisión (no publica solo)

default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID", "Y4G39PY7CG"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID", "a2afdadf-5348-49b3-ae25-ddfc0a930044"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      in_house: false
    )
  end

  before_all do
    sh("cd .. && xcodegen generate")
  end

  desc "Compila y corre las pruebas unitarias"
  lane :tests do
    run_tests(project: "CuyPay.xcodeproj", scheme: "CuyPay-Dev", device: "iPhone 17")
  end

  desc "Build Prod firmado → TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = asc_key
    match(
      type: "appstore",
      git_url: ENV.fetch("MATCH_GIT_URL", "https://github.com/bdortiz16/cuypay-certificates.git"),
      readonly: ENV["CUYPAY_MATCH_READONLY"] == "true", # setup_ci fuerza MATCH_READONLY=true; por eso usamos variable propia
      api_key: api_key
    )
    remote_build = begin
      latest_testflight_build_number(api_key: api_key)
    rescue
      7
    end
    run_num = ENV["GITHUB_RUN_NUMBER"] ? ENV["GITHUB_RUN_NUMBER"].to_i : 0
    next_build = [remote_build + 1, run_num, 8].max
    increment_build_number(
      xcodeproj: "CuyPay.xcodeproj",
      build_number: next_build
    )
    team_id = ENV.fetch("CUYPAY_TEAM_ID", "YRFDF3T7CQ")
    # Firma manual solo para el target de la app (no para los paquetes SPM), con el perfil que creó match.
    update_code_signing_settings(
      path: "CuyPay.xcodeproj",
      use_automatic_signing: false,
      targets: ["CuyPay"],
      build_configurations: ["Prod"],
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("sigh_com.cuypay.app_appstore_profile-name")
    )
    build_app(
      project: "CuyPay.xcodeproj",
      scheme: "CuyPay-Prod",
      configuration: "Prod",
      export_method: "app-store"
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Sube el build a App Store Connect y lo envía a revisión (la publicación es manual)"
  lane :release do
    api_key = asc_key
    beta
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false,
      submission_information: { export_compliance_uses_encryption: false, add_id_info_uses_idfa: false }
    )
  end
end
