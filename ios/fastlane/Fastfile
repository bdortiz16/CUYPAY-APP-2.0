# Automatización de publicación de CuyPay iOS.
#
# Variables de entorno necesarias (en tu Mac o como secretos de GitHub):
#   CUYPAY_TEAM_ID              Team ID de Apple Developer (10 caracteres)
#   ASC_KEY_ID                  App Store Connect API key: Key ID
#   ASC_ISSUER_ID               App Store Connect API key: Issuer ID
#   ASC_KEY_CONTENT             Contenido del archivo .p8 (texto)
#   MATCH_GIT_URL               Repo privado donde fastlane match guarda certificados y perfiles
#   MATCH_PASSWORD              Contraseña con la que match cifra ese repo
#
# Uso:
#   bundle exec fastlane tests       # compila y corre pruebas
#   bundle exec fastlane beta        # sube un build Prod a TestFlight
#   bundle exec fastlane release     # sube el build a App Store Connect para revisión (no publica solo)

default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      in_house: false
    )
  end

  before_all do
    sh("cd .. && xcodegen generate")
  end

  desc "Compila y corre las pruebas unitarias"
  lane :tests do
    run_tests(project: "CuyPay.xcodeproj", scheme: "CuyPay-Dev", device: "iPhone 17")
  end

  desc "Build Prod firmado → TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = asc_key
    match(type: "appstore", readonly: is_ci, api_key: api_key)
    increment_build_number(
      xcodeproj: "CuyPay.xcodeproj",
      build_number: latest_testflight_build_number(api_key: api_key) + 1
    )
    build_app(
      project: "CuyPay.xcodeproj",
      scheme: "CuyPay-Prod",
      configuration: "Prod",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('CUYPAY_TEAM_ID', 'YRFDF3T7CQ')} CODE_SIGN_STYLE=Manual"
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Sube el build a App Store Connect y lo envía a revisión (la publicación es manual)"
  lane :release do
    api_key = asc_key
    beta
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false,
      submission_information: { export_compliance_uses_encryption: false, add_id_info_uses_idfa: false }
    )
  end
end
